{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Etymology Tree",
    "definitions": {
        "originLanguage": {
            "type": "object",
            "required": [
                "iso_639_3_code",
                "full_language_name"
            ],
            "properties": {
                "iso_639_3_code": {
                    "type": "string"
                },
                "full_language_name": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "exampleWord": {
            "type": "object",
            "required": [
                "word",
                "simple_definition",
                "language"
            ],
            "properties": {
                "word": {
                    "type": "string"
                },
                "simple_definition": {
                    "type": "string"
                },
                "language": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "baseNode": {
            "type": "object",
            "required": [
                "entry",
                "type",
                "definition"
            ],
            "properties": {
                "entry": {
                    "type": "string"
                },
                "definition": {
                    "type": "string"
                },
                "origin_language": {
                    "$ref": "#/definitions/originLanguage"
                },
                "notes": {
                    "type": "string"
                },
                "examples": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/exampleWord"
                    }
                },
                "ancestors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/etymologyNode"
                    }
                }
            }
        },
        "breakableNode": {
            "allOf": [
                {
                    "$ref": "#/definitions/baseNode"
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "oneOf": [
                                {
                                    "const": "compound",
                                    "description": "A word formed by combining morphemes"
                                },
                                {
                                    "const": "phrase",
                                    "description": "A multi-word expression"
                                }
                            ]
                        },
                        "components": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/etymologyNode"
                            }
                        }
                    },
                    "required": [
                        "components"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "atomicNode": {
            "allOf": [
                {
                    "$ref": "#/definitions/baseNode"
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "oneOf": [
                                {
                                    "const": "root",
                                    "description": "Core semantic morpheme"
                                },
                                {
                                    "const": "prefix",
                                    "description": "Morpheme attached before root"
                                },
                                {
                                    "const": "suffix",
                                    "description": "Morpheme attached after root"
                                },
                                {
                                    "const": "infix",
                                    "description": "Inserted morpheme"
                                },
                                {
                                    "const": "connector",
                                    "description": "Linking morpheme"
                                }
                            ]
                        }
                    },
                    "not": {
                        "required": [
                            "components"
                        ]
                    },
                    "additionalProperties": false
                }
            ]
        },
        "etymologyNode": {
            "oneOf": [
                {
                    "$ref": "#/definitions/breakableNode"
                },
                {
                    "$ref": "#/definitions/atomicNode"
                }
            ]
        }
    },
    "$ref": "#/definitions/etymologyNode"
}